// sovtech-www -- www.sovtech.pro: Cameron's personal page, plain HTML + CSS served as static
// assets. There is no Worker code and no build step: public/ is the site, byte for byte.
//
//   * The apex sovtech.pro is NOT here and must not be: its A record stays on the VPS (the PTR is
//     sovtech.pro and postfix HELOs as it), and its TLS ends on l5400 apex-edge, which serves the
//     NIP-05 file and 301s everything else to www.
//   * The planning-agent Worker `sovtech` (feat/planning-agent-*) is a DIFFERENT Worker and is left
//     untouched; its isolated staging `sovtech-test` runs at pre.sovtech.pro.
// Preview: npm ci && npm run dev    Deploy (clean main only): CLOUDFLARE_ACCOUNT_ID=<Sovereign IT> npm run deploy
// Security headers and the CSP live in public/_headers; old paths are redirected in public/_redirects.
{
  "name": "sovtech-www",
  "compatibility_date": "2026-02-08",
  // No second public hostname (sovtech-www.<acct>.workers.dev) and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.sovtech.pro", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
